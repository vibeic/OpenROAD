VERSION 5.8 ;
DIVIDERCHAR "/" ;
BUSBITCHARS "[]" ;
DESIGN coupling_fill ;
UNITS DISTANCE MICRONS 1000 ;
DIEAREA ( 0 0 ) ( 200000 100000 ) ;
SPECIALNETS 2 ;
- VDD
  + ROUTED met1 50000 ( 0 50000 ) ( 50000 * )
  + USE POWER ;
- crit
  + ROUTED met1 2000 ( 150000 0 ) ( 150000 100000 )
  + USE SIGNAL ;
END SPECIALNETS
END DESIGN
