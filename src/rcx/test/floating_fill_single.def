VERSION 5.8 ;
DIVIDERCHAR "/" ;
BUSBITCHARS "[]" ;
DESIGN floating_fill_single ;
UNITS DISTANCE MICRONS 2000 ;
DIEAREA ( 0 0 ) ( 10000 3000 ) ;
PINS 4 ;
- A0 + NET A + DIRECTION INPUT + USE SIGNAL
  + LAYER metal1 ( -35 -35 ) ( 35 35 ) + PLACED ( 1000 1000 ) N ;
- A1 + NET A + DIRECTION OUTPUT + USE SIGNAL
  + LAYER metal1 ( -35 -35 ) ( 35 35 ) + PLACED ( 9000 1000 ) N ;
- B0 + NET B + DIRECTION INPUT + USE SIGNAL
  + LAYER metal1 ( -35 -35 ) ( 35 35 ) + PLACED ( 1000 2000 ) N ;
- B1 + NET B + DIRECTION OUTPUT + USE SIGNAL
  + LAYER metal1 ( -35 -35 ) ( 35 35 ) + PLACED ( 9000 2000 ) N ;
END PINS
NETS 2 ;
- A ( PIN A0 ) ( PIN A1 ) + USE SIGNAL
  + ROUTED metal1 ( 1000 1000 ) ( 9000 * ) ;
- B ( PIN B0 ) ( PIN B1 ) + USE SIGNAL
  + ROUTED metal1 ( 1000 2000 ) ( 9000 * ) ;
END NETS
FILLS 2 ;
- LAYER metal1 RECT ( 2000 1400 ) ( 4500 1600 ) ;
- LAYER metal1 RECT ( 5500 1400 ) ( 8000 1600 ) ;
END FILLS
END DESIGN
