VERSION 5.8 ;
DIVIDERCHAR "/" ;
BUSBITCHARS "[]" ;
DESIGN ns_metal_repair ;
UNITS DISTANCE MICRONS 1000 ;
DIEAREA ( 0 0 ) ( 60000 60000 ) ;
TRACKS X 1700 DO 17 STEP 3400 LAYER met5 ;
TRACKS Y 1700 DO 17 STEP 3400 LAYER met5 ;
GCELLGRID X 0 DO 13 STEP 5000 ;
GCELLGRID Y 0 DO 13 STEP 5000 ;
COMPONENTS 0 ;
END COMPONENTS
PINS 0 ;
END PINS
NETS 1 ;
- n1
  + ROUTED met5 ( 10000 10000 ) RECT ( 0 0 2500 2500 )
    NEW met5 ( 12400 12400 ) RECT ( 0 0 2500 2500 )
  ;
END NETS
END DESIGN
