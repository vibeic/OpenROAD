VERSION 5.8 ;
DIVIDERCHAR "/" ;
BUSBITCHARS "[]" ;
DESIGN via_patch_min_width ;
UNITS DISTANCE MICRONS 1000 ;
DIEAREA ( 0 0 ) ( 140000 60000 ) ;
TRACKS X 460 DO 152 STEP 920 LAYER met4 ;
TRACKS Y 1700 DO 17 STEP 3400 LAYER met5 ;
GCELLGRID X 0 DO 29 STEP 5000 ;
GCELLGRID Y 0 DO 13 STEP 5000 ;
COMPONENTS 0 ;
END COMPONENTS
PINS 0 ;
END PINS
NETS 3 ;
- n_end
  + ROUTED met5 ( 20000 20400 0 ) ( 40000 * 0 )
    NEW met5 ( 20150 20400 0 ) M4M5_PR
    NEW met4 ( 20150 20400 0 ) ( * 12000 0 )
  ;
- n_mid
  + ROUTED met5 ( 52150 30600 0 ) ( 80000 * 0 )
    NEW met5 ( 60150 30600 0 ) M4M5_PR
    NEW met4 ( 60150 30600 0 ) ( * 22000 0 )
  ;
- n_ext
  + ROUTED met5 ( 99440 40800 0 ) ( 120000 * 0 )
    NEW met5 ( 100150 40800 0 ) M4M5_PR
    NEW met4 ( 100150 40800 0 ) ( * 32000 0 )
  ;
END NETS
END DESIGN
